<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ takes the icon from here and applies its own mask, so the
     dealer is kept inside the 72dp safe window by tool/make_icons.py.
     The legacy mipmap-*/ic_launcher.png bitmaps still serve API 25 and below. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
