<?xml version="1.0" encoding="utf-8"?>
<!-- The window Android shows while the Flutter engine starts: the app's own
     near-black felt colour with the wordmark centred, rather than the
     template's white flash. Automatically replaced by the first Flutter
     frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/shell_black" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_logo" />
    </item>
</layer-list>
