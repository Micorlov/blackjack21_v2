rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player's membership pointer — private to its owner.
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Friends groups. Codes are shared over WhatsApp; any signed-in player
    // holding a code may look the group up and read its scoreboard, but a
    // member row can only be written by the player it belongs to.
    match /groups/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;

      match /players/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
